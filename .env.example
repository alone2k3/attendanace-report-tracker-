# Copy to .env.local (never commit .env.local)

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" / publishable key; safe for the browser because RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret "service_role" key; server-only (cron and email routes). Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ_APP=Asia/Kolkata

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Turmeric Work Tracker <tracker@yourcompany.com>"

# Protects /api/cron/* routes
CRON_SECRET=
